---
import Base from "../../layouts/Base.astro";
import ContactForm from "../../components/ContactForm.astro";
import Drawing from "../../components/Drawing.astro";
import { getDict, localeStaticPaths } from "../../i18n";
import { CONTACT_EMAIL, type Locale } from "../../config";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
const c = dict.contact;
---

<Base locale={locale} dict={dict} path="/contact/" title={`${c.title} — near`} description={c.body}>
  <section class="container-x pb-10 pt-36 md:pt-44">
    <div class="grid gap-14 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16 lg:gap-24">
      <div class="md:sticky md:top-32 md:self-start" data-reveal-group>
        <div data-reveal="pop"><Drawing name="ear" size={120} class="w-[88px] md:w-[104px]" /></div>
        <h1 class="h-section mt-6" data-reveal>{c.title}</h1>
        <p class="lede mt-4" data-reveal>{c.body}</p>
        <p class="mt-4" data-reveal>
          <a class="link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
      </div>

      <div data-reveal>
        <ContactForm dict={dict} locale={locale} />
      </div>
    </div>
  </section>
</Base>
