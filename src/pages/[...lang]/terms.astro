---
import Base from "../../layouts/Base.astro";
import Legal from "../../components/Legal.astro";
import { getDict, localeStaticPaths } from "../../i18n";
import type { Locale } from "../../config";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
const t = dict.terms;
---

<Base locale={locale} dict={dict} path="/terms/" title={`${t.title} — near`} description={t.intro}>
  <Legal locale={locale} dict={dict} title={t.title} intro={t.intro} sections={t.sections} contact={t.contact} />
</Base>
