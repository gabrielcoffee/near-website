---
import Base from "../../layouts/Base.astro";
import Legal from "../../components/Legal.astro";
import { getDict, localeStaticPaths } from "../../i18n";
import type { Locale } from "../../config";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
const p = dict.privacy;
---

<Base locale={locale} dict={dict} path="/privacy/" title={`${p.title} — Near`} description={p.intro}>
  <Legal locale={locale} dict={dict} title={p.title} intro={p.intro} sections={p.sections} contact={p.contact} />
</Base>
