---
/* Shared layout for /privacy/ and /terms/: title, date, intro, sections with optional bullets, contact line. */
import { CONTACT_EMAIL, LEGAL_ENTITY, LEGAL_UPDATED, type Locale } from "../config";
import type { Dictionary, LegalSection } from "../i18n/en";

interface Props {
  locale: Locale;
  dict: Dictionary;
  title: string;
  intro: string;
  sections: LegalSection[];
  contact: { title: string; body: string };
}
const { locale, dict, title, intro, sections, contact } = Astro.props;
const DATE_LOCALE: Record<Locale, string> = { en: "en-US", pt: "pt-BR", es: "es-ES", fr: "fr-FR", de: "de-DE", it: "it-IT", ru: "ru-RU" };
// Dictionary strings say {entity} where the operator's legal name and address go.
// A [label](https://…) in a string becomes a link; everything else is escaped.
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const fill = (text: string) =>
  esc(text.replaceAll("{entity}", LEGAL_ENTITY)).replace(
    /\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g,
    '<a class="link" href="$2" target="_blank" rel="noopener noreferrer">$1</a>',
  );
const updated = new Date(`${LEGAL_UPDATED}T12:00:00Z`).toLocaleDateString(DATE_LOCALE[locale], { year: "numeric", month: "long", day: "numeric" });
---

<section class="container-x pb-10 pt-36 md:pt-44">
  <div class="max-w-2xl">
    <h1 class="h-section" data-reveal>{title}</h1>
    <p class="mt-3 text-small text-muted" data-reveal>{dict.legal.updated} <time datetime={LEGAL_UPDATED}>{updated}</time></p>
    <p class="lede mt-6" data-reveal>{intro}</p>

    <nav class="legal-toc mt-10" aria-label={dict.legal.contents} data-reveal>
      <p class="text-small font-medium text-ink">{dict.legal.contents}</p>
      <ol class="mt-3 grid gap-x-8 gap-y-1.5 text-small sm:grid-cols-2">
        {
          sections.map((s, i) => (
            <li>
              <a href={`#s-${i + 1}`}>
                {s.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    {
      sections.map((s, i) => (
        <div id={`s-${i + 1}`} class="mt-14 scroll-mt-[-1rem]" data-reveal>
          <h2 class="text-title font-medium tracking-tight text-balance">{s.title}</h2>
          {(Array.isArray(s.body) ? s.body : [s.body]).map((para) => <p class="mt-3 text-body text-ink/75 text-pretty" set:html={fill(para)} />)}
          {s.items && (
            <ul class="legal-list mt-4 flex flex-col gap-2 text-body text-ink/75">
              {s.items.map((item) => <li set:html={fill(item)} />)}
            </ul>
          )}
          {s.after && <p class="mt-4 text-body text-ink/75 text-pretty" set:html={fill(s.after)} />}
        </div>
      ))
    }

    <div class="mt-14 border-t border-line pt-8" data-reveal>
      <h2 class="text-title font-medium tracking-tight">{contact.title}</h2>
      <p class="mt-3 text-body text-ink/75">
        {contact.body} <a class="link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .legal-toc {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .legal-toc ol {
    list-style: none;
    padding: 0;
  }
  .legal-toc a {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }
  .legal-toc a:hover {
    color: var(--color-ink);
    transition-duration: 0s;
  }
</style>
