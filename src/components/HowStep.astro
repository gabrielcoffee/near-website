---
// One "how it works" row: a screenshot and, beside it, the title and one line. The picture comes first on a phone;
// on wider screens the rows alternate sides (`flip`).
import Shot from "./Shot.astro";

interface Props {
  shot: string;
  title: string;
  body: string;
  flip?: boolean;
}
const { shot, title, body, flip = false } = Astro.props;
---

<li class="grid items-center gap-8 md:grid-cols-2 md:gap-16" data-reveal-group>
  <div class:list={["flex justify-center", flip && "md:order-2"]} data-reveal="pop">
    <Shot name={shot} class="w-[160px] md:w-[180px] lg:w-[200px]" />
  </div>
  <div class:list={["max-w-md", flip ? "md:justify-self-end" : ""]} data-reveal>
    <h3 class="text-title font-medium tracking-tight text-balance">{title}</h3>
    <p class="lede mt-3">{body}</p>
  </div>
</li>
