---
// What we believe: a drawing beside a few short paragraphs on what social media costs and why Near is small.
import type { Dictionary } from "../i18n/en";
import Drawing from "./Drawing.astro";

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
---

<section id="what-we-believe" class="section relative scroll-mt-[-4rem] md:scroll-mt-[-7rem]">
  <div class="container-x">
    <div class="grid items-center gap-10 md:grid-cols-[220px_1fr] md:gap-16">
      <div class="flex justify-start md:justify-center" data-reveal="pop">
        <Drawing name="actually" size={220} class="w-[150px] md:w-[200px] lg:w-[220px]" />
      </div>
      <div class="max-w-xl" data-reveal-group>
        <h2 class="h-section" data-reveal>{dict.nav.believe}</h2>
        {dict.believe.paragraphs.map((t) => <p class="lede mt-4" data-reveal>{t}</p>)}
      </div>
    </div>
  </div>
</section>
