---
/**
 * The logo: two overlapping orange circles + "Near". One source of truth for header, hero and
 * footer; the same mark is public/favicon.svg and the app icon. The overlap is a clipped circle
 * in the darker orange (what multiply gives) rather than mix-blend-mode, so it renders the same
 * everywhere, favicons included. Styles in global.css (.wordmark).
 */
interface Props {
  href?: string;
  text?: string;
  class?: string;
  ariaLabel?: string;
}
const { href, text = "Near", class: cls = "", ariaLabel } = Astro.props;
const clipId = `wm-${Math.random().toString(36).slice(2, 8)}`;
---

{
  href ? (
    <a href={href} class:list={["wordmark", cls]} aria-label={ariaLabel}>
      <svg class="wordmark-mark" viewBox="0 0 100 100" aria-hidden="true">
        <clipPath id={clipId}><circle cx="35.3" cy="35.3" r="35.3" /></clipPath>
        <circle cx="35.3" cy="35.3" r="35.3" class="mark-circle" />
        <circle cx="64.7" cy="64.7" r="35.3" class="mark-circle" />
        <circle cx="64.7" cy="64.7" r="35.3" class="mark-overlap" clip-path={`url(#${clipId})`} />
      </svg>
      {text}
    </a>
  ) : (
    <span class:list={["wordmark", cls]}>
      <svg class="wordmark-mark" viewBox="0 0 100 100" aria-hidden="true">
        <clipPath id={clipId}><circle cx="35.3" cy="35.3" r="35.3" /></clipPath>
        <circle cx="35.3" cy="35.3" r="35.3" class="mark-circle" />
        <circle cx="64.7" cy="64.7" r="35.3" class="mark-circle" />
        <circle cx="64.7" cy="64.7" r="35.3" class="mark-overlap" clip-path={`url(#${clipId})`} />
      </svg>
      {text}
    </span>
  )
}
