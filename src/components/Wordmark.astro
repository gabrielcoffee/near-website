---
/**
 * The logo: the hand-drawn mark (two orange faces, `public/near-mark.webp`, the app's mark) + "Near". One
 * source of truth for header, hero and footer; favicon, touch icon and OG image are cut from the same
 * drawing. The image is trimmed to the drawing's edges so it fills the same 0.85em box the old circles did.
 * Styles in global.css (.wordmark).
 */
interface Props {
  href?: string;
  text?: string;
  class?: string;
  ariaLabel?: string;
}
const { href, text = "Near", class: cls = "", ariaLabel } = Astro.props;
---

{
  href ? (
    <a href={href} class:list={["wordmark", cls]} aria-label={ariaLabel}>
      <img class="wordmark-mark" src="/near-mark.webp" width="367" height="367" alt="" aria-hidden="true" />
      {text}
    </a>
  ) : (
    <span class:list={["wordmark", cls]}>
      <img class="wordmark-mark" src="/near-mark.webp" width="367" height="367" alt="" aria-hidden="true" />
      {text}
    </span>
  )
}
