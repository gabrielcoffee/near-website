---
// One screenshot of the app inside an iPhone 17 Pro drawn in CSS (Cosmic Orange frame, black bezel, the four side
// buttons). Pictures live in `src/assets/shots/<locale>/<name>.png` (simulator captures, 1206 × 2622); a locale
// without its own set falls back to English, and a missing file shows a quiet placeholder of the same shape.
// Every measurement is in `cqw` (percent of the phone's width), so the phone scales as one piece.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Locale } from "../config";

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*/*.png", { eager: true });

interface Props {
  name: string;
  locale?: Locale;
  alt?: string;
  class?: string;
}
const { name, locale = "en", alt = "", class: cls = "" } = Astro.props;
const img = (shots[`../assets/shots/${locale}/${name}.png`] ?? shots[`../assets/shots/en/${name}.png`])?.default;
---

<div class:list={["device", cls]} data-shot={name}>
  <div class="frame">
    <span class="btn-side btn-action" aria-hidden="true"></span>
    <span class="btn-side btn-vol-up" aria-hidden="true"></span>
    <span class="btn-side btn-vol-down" aria-hidden="true"></span>
    <span class="btn-side btn-power" aria-hidden="true"></span>
    <span class="btn-side btn-camera" aria-hidden="true"></span>
    <div class="bezel">
      <div class="screen">
        {
          img ? (
            <Image src={img} alt={alt} widths={[120, 220, 330]} sizes="(min-width: 1024px) 108px, (min-width: 768px) 100px, 92px" class="h-full w-full object-cover" />
          ) : (
            <span class="shot-empty">{name}</span>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .device {
    container-type: inline-size;
    width: 100%;
    filter: drop-shadow(0 30px 40px rgb(28 28 30 / 0.22)) drop-shadow(0 8px 12px rgb(28 28 30 / 0.12));
  }
  /* The aluminium band: a lit edge on the left, a darker one on the right. */
  .frame {
    position: relative;
    padding: 1.4cqw;
    border-radius: 16.4cqw;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.35), transparent 6%, transparent 94%, rgb(0 0 0 / 0.25)),
      linear-gradient(180deg, #f39a5b 0%, #e5732e 45%, #c95c1f 100%);
    box-shadow:
      inset 0 0 0 0.35cqw rgb(255 255 255 / 0.28),
      inset 0 0 0 0.7cqw rgb(120 45 10 / 0.25);
  }
  .bezel {
    padding: 3.1cqw;
    border-radius: 15cqw;
    background: #0a0a0b;
    box-shadow: inset 0 0 0 0.4cqw #1f1f22;
  }
  .screen {
    aspect-ratio: 1206 / 2622;
    overflow: hidden;
    border-radius: 11.9cqw;
    background: #1c1c1e;
    display: grid;
    place-items: center;
  }
  .btn-side {
    position: absolute;
    width: 1.3cqw;
    border-radius: 1cqw;
    background: linear-gradient(90deg, #b9531b, #f0904f 50%, #b9531b);
  }
  .btn-action,
  .btn-vol-up,
  .btn-vol-down {
    left: -1cqw;
  }
  .btn-power,
  .btn-camera {
    right: -1cqw;
  }
  .btn-action {
    top: 22%;
    height: 7%;
  }
  .btn-vol-up {
    top: 31.5%;
    height: 11%;
  }
  .btn-vol-down {
    top: 44.5%;
    height: 11%;
  }
  .btn-power {
    top: 34%;
    height: 16%;
  }
  .btn-camera {
    top: 61%;
    height: 8%;
    width: 1.1cqw;
  }
  .shot-empty {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
</style>
