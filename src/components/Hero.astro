---
import type { Dictionary } from "../i18n/en";
import Drawing from "./Drawing.astro";

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
---

<section class="relative flex min-h-svh items-center justify-center overflow-hidden pt-24 pb-16" data-parallax-root>
  <!-- Edge characters. Positions are % of the hero; tweak freely. -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="edge left-[24.5%] top-[18.1%] hidden md:block" data-depth="0.6"><Drawing name="happy" size={150} class="w-[110px] lg:w-[150px]" eager /></div>
    <div class="edge right-[42.7%] top-[58.4%]" data-depth="0.8"><Drawing name="wohoo" size={130} class="w-[72px] md:w-[100px] lg:w-[130px]" eager /></div>
    <div class="edge left-[22.3%] top-[55.3%] hidden lg:block" data-depth="1"><Drawing name="cool" size={171} class="w-[171px]" eager /></div>
    <div class="edge right-[24.5%] top-[17.8%] hidden lg:block" data-depth="0.5"><Drawing name="friends" size={170} class="w-[170px]" eager /></div>
    <div class="edge left-[78.6%] bottom-[41.5%]" data-depth="0.9"><Drawing name="shoes" size={95} class="w-[52px] md:w-[69px] lg:w-[95px]" eager /></div>
    <div class="edge right-[80.7%] bottom-[47.6%] hidden md:block" data-depth="0.7"><Drawing name="nose" size={110} class="w-[80px] lg:w-[110px]" eager /></div>
    <div class="edge left-[44.5%] top-[13.3%] hidden lg:block" data-depth="1.1"><Drawing name="tinyhappy" size={85} class="w-[85px]" eager /></div>
    <div class="edge left-[66.7%] top-[50.6%]" data-depth="0.4"><Drawing name="back" size={104} class="w-[68px] md:w-[88px] lg:w-[104px]" eager /></div>
  </div>

  <!-- pointer-events-none so edge characters under this full-width box stay hoverable/draggable -->
  <div class="container-x pointer-events-none relative flex flex-col items-center pb-[18vh] text-center">
    <h1 class="hero-title swipe pointer-events-auto text-4xl font-medium tracking-tight md:text-5xl">
      <span class="swipe-inner inline-flex items-center gap-[0.4em]"><span class="hero-dot" aria-hidden="true"></span>{dict.hero.title}</span>
    </h1>
    <p class="hero-tag swipe pointer-events-auto mt-3 max-w-xs text-lg text-muted md:text-xl">
      <span class="swipe-inner">{dict.hero.tagline}</span>
    </p>
  </div>

  <a
    href="#how-it-works"
    class="scroll-hint absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1 text-xs text-muted"
    data-scroll-hint
    aria-label={dict.hero.scroll}
  >
    <span>{dict.hero.scroll}</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 5v14M6 13l6 6 6-6"></path>
    </svg>
  </a>
</section>

<style>
  /* Same logo as the header wordmark: orange dot, a touch under cap height. */
  .hero-dot {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    border-radius: 999px;
    background: var(--color-accent);
    transition: transform 0.3s var(--ease-spring);
  }
  .hero-title:hover .hero-dot {
    transform: scale(1.35);
  }
  .edge {
    position: absolute;
    pointer-events: auto;
    transition: transform 0.9s var(--ease-soft);
    will-change: transform;
  }
  .scroll-hint {
    transition: opacity 0.4s ease, transform 0.4s ease;
    animation: nudge 2.4s ease-in-out infinite;
  }
  .scroll-hint.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  @keyframes nudge {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint { animation: none; }
    .edge { transition: none; }
  }
</style>
