---
import { APP_STORE_URL, WAITLIST_ENABLED, type Locale } from "../config";
import type { Dictionary } from "../i18n/en";
import Button from "./Button.astro";
import Drawing from "./Drawing.astro";
import Waitlist from "./Waitlist.astro";

interface Props {
  dict: Dictionary;
  locale?: Locale;
}
const { dict, locale = "en" } = Astro.props;
const live = Boolean(APP_STORE_URL);
// Until the app ships, the card collects emails instead of linking to the store.
const waitlist = !live && WAITLIST_ENABLED;
---

<section id="get-the-app" class="pb-16 pt-0 md:pb-24">
  <div class="container-x">
    <div class="card relative overflow-hidden px-6 pt-16 pb-28 text-center md:px-12 md:py-24" data-reveal-group>
      <div class="pointer-events-none absolute -bottom-1 left-1 md:-bottom-2 md:left-[6%]" aria-hidden="true" data-reveal="pop">
        <Drawing name="run" size={180} class="w-[84px] md:w-[140px] lg:w-[180px] pointer-events-auto" />
      </div>
      <div class="pointer-events-none absolute -bottom-1 right-1 md:-bottom-3 md:right-[8%]" aria-hidden="true" data-reveal="pop">
        <Drawing name="friends" size={160} class="w-[92px] md:w-[130px] lg:w-[160px] pointer-events-auto" />
      </div>

      <h2 class="h-section" data-reveal>{dict.cta.title}</h2>
      <p class="lede mx-auto mt-3 max-w-md" data-reveal>{dict.cta.body}</p>

      {
        waitlist ? (
          <div class="mt-8" data-reveal>
            <Waitlist dict={dict} locale={locale} />
            <p class="mt-4 text-sm text-muted">{dict.cta.soon}</p>
          </div>
        ) : (
          <div class="mt-8 flex justify-center" data-reveal>
            <Button href={APP_STORE_URL || undefined} size="lg" disabled={!live} target={live ? "_blank" : undefined} rel={live ? "noopener" : undefined}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
              </svg>
              {live ? dict.cta.button : dict.cta.soon}
            </Button>
          </div>
        )
      }
    </div>
  </div>
</section>
