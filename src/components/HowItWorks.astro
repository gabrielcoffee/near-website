---
// Three rows, show don't tell: adding a friend face to face, the feed that ends, your profile. Screenshots in
// `src/assets/shots/<locale>/` (`add-friend` + `add-friend-match`, `feed` + `comments`, `profile`; en and pt today, the rest fall back to en).
import type { Locale } from "../config";
import type { Dictionary } from "../i18n/en";
import Drawing from "./Drawing.astro";
import HowStep from "./HowStep.astro";

interface Props {
  dict: Dictionary;
  locale: Locale;
}
const { dict, locale } = Astro.props;
const shots = [["add-friend", "add-friend-match"], ["feed", "comments"], ["profile"]];
---

<section id="how-it-works" class="section relative scroll-mt-[-4rem] md:scroll-mt-[-7rem]">
  <div class="container-x">
    <div class="mb-12 max-w-xl md:mb-16" data-reveal-group>
      <h2 class="h-section" data-reveal>{dict.nav.how}</h2>
    </div>

    <ol class="flex flex-col gap-20 md:gap-28">
      {dict.how.steps.map((s, i) => <HowStep shots={shots[i]} locale={locale} title={s.title} body={s.body} flip={i % 2 === 1} />)}
    </ol>
  </div>

  <div class="pointer-events-none absolute -left-4 top-[30%] hidden xl:block" aria-hidden="true" data-reveal="pop">
    <Drawing name="hearing" size={140} class="w-[140px] pointer-events-auto" />
  </div>
</section>
