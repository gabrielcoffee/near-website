---
// What you won't find on Near: the things other apps have that Near leaves out, as a 2×2 grid. Each drawing sits on
// the outer edge of its cell (left column on the left, right column on the right), so the four characters frame the
// block; on a phone the cells stack and every drawing goes back to the left.
import type { Dictionary } from "../i18n/en";
import Drawing from "./Drawing.astro";

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
// Order matches dict.without.items: ads, algorithm, endless scroll, strangers. Ads and strangers draw bigger
// characters, so they get smaller widths to look the same size as the other two.
const itemDrawings = ["ew", "hearing", "old", "random"];
const width: Record<string, string> = {
  ew: "w-[80px] md:w-[115px] lg:w-[130px]",
  random: "w-[70px] md:w-[100px] lg:w-[115px]",
};
---

<section id="without" class="section relative scroll-mt-[-4rem] md:scroll-mt-[-7rem]">
  <div class="container-x">
    <div class="mx-auto max-w-5xl">
      <div class="max-w-xl" data-reveal-group>
        <h2 class="h-section" data-reveal>{dict.without.title}</h2>
      </div>

      <ul class="mt-12 grid gap-x-12 gap-y-12 md:mt-16 md:grid-cols-2 md:gap-y-16">
        {dict.without.items.map((c, i) => (
          <li class:list={["flex items-center gap-5 md:gap-6", i % 2 === 1 && "md:flex-row-reverse"]} data-reveal-group>
            <div class="flex w-[96px] shrink-0 justify-center md:w-[140px] lg:w-[160px]" data-reveal="pop">
              <Drawing
                name={itemDrawings[i]}
                size={160}
                class={width[itemDrawings[i]] ?? "w-[96px] md:w-[140px] lg:w-[160px]"}
              />
            </div>
            <div class="min-w-0 flex-1" data-reveal>
              <h3 class="text-title font-medium tracking-tight text-balance">{c.title}</h3>
              <p class="lede mt-2">{c.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
