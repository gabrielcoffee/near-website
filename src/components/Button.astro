---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  disabled?: boolean;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: cls = "",
  disabled = false,
  target,
  rel,
  ariaLabel,
} = Astro.props;

const classes = ["btn", `btn-${variant}`, `btn-${size}`, cls];
---

{
  disabled ? (
    <span class:list={classes} aria-disabled="true" role="button">
      <slot />
    </span>
  ) : (
    <a class:list={classes} href={href} target={target} rel={rel} aria-label={ariaLabel}>
      <slot />
    </a>
  )
}
