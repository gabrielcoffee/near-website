---
// One "how it works" step: title, body. Parent drives `data-step` / `.is-active`.
interface Props {
  index: number;
  title: string;
  body: string;
  class?: string;
}
const { index, title, body, class: cls = "" } = Astro.props;
---

<li class:list={["step flex items-center py-10 lg:min-h-[60vh] lg:py-0", cls]} data-step={index}>
  <div class="max-w-md" data-reveal>
    <h3 class="text-title font-medium tracking-tight">{title}</h3>
    <p class="lede mt-3">{body}</p>
  </div>
</li>

<style>
  .step h3,
  .step p {
    transition: opacity 0.4s ease;
  }
  @media (min-width: 1024px) {
    .step:not(.is-active) h3,
    .step:not(.is-active) p {
      opacity: 0.4;
    }
  }
</style>
