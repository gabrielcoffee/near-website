---
// One "how it works" step: number, title, body. Parent drives `data-step` / `.is-active`.
interface Props {
  index: number;
  title: string;
  body: string;
  class?: string;
}
const { index, title, body, class: cls = "" } = Astro.props;
---

<li class:list={["step flex items-center py-10 lg:min-h-[60vh] lg:py-0", cls]} data-step={index}>
  <div class="max-w-md" data-reveal>
    <span class="step-num">{String(index + 1).padStart(2, "0")}</span>
    <h3 class="mt-3 text-2xl font-medium tracking-tight md:text-3xl">{title}</h3>
    <p class="lede mt-3">{body}</p>
  </div>
</li>

<style>
  .step-num {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-muted);
    transition: color 0.3s ease;
  }
  .step.is-active .step-num {
    color: var(--color-accent);
  }
  .step h3,
  .step p {
    transition: opacity 0.4s ease;
  }
  @media (min-width: 1024px) {
    .step:not(.is-active) h3,
    .step:not(.is-active) p {
      opacity: 0.4;
    }
  }
</style>
