---
import { APP_STORE_URL, type Locale } from "../config";
import { localePath } from "../i18n";
import type { Dictionary } from "../i18n/en";
import Button from "./Button.astro";
import LangSwitch from "./LangSwitch.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  locale: Locale;
  path: string;
  dict: Dictionary;
  position?: "fixed" | "absolute" | "static"; // fixed on the site; absolute inside a preview stage; static in flow
}

const { locale, path, dict, position = "fixed" } = Astro.props;
const home = localePath(locale, "/");
// On the home page keep hrefs as bare hashes: Lenis only smooth-scrolls (with the header offset) for those.
const anchor = (id: string) => (path === "/" ? `#${id}` : `${home}#${id}`);
const ctaHref = APP_STORE_URL || anchor("get-the-app");
---

<div
  class:list={[
    "site-header-wrap px-3 md:px-6",
    position === "fixed" && "fixed inset-x-0 top-3 z-50 md:top-4",
    position === "absolute" && "absolute inset-x-0 top-3 z-40 md:top-4",
    position === "static" && "relative",
  ]}
>
  <header
    class="site-header relative mx-auto flex max-w-5xl items-center justify-between gap-3 border border-line/80 px-3 py-2 md:px-4"
    data-header
  >
    <Wordmark href={home} class="px-2 text-xl" ariaLabel="Near" />

    <nav
      class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-7 md:flex"
      aria-label="Main"
    >
      <a href={anchor("how-it-works")} class="nav-link text-[15px]">{dict.nav.how}</a>
      <a href={anchor("coming-next")} class="nav-link text-[15px]">{dict.nav.next}</a>
      <a href={anchor("what-we-believe")} class="nav-link text-[15px]">{dict.nav.believe}</a>
    </nav>

    <div class="flex items-center gap-1.5">
      <LangSwitch locale={locale} path={path} dict={dict} />
      <Button href={ctaHref} size="sm">{dict.nav.cta}</Button>
    </div>
  </header>
</div>

<style>
  .site-header {
    border-radius: var(--header-radius);
    background-color: rgb(255 255 255 / var(--header-bg));
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
    transition:
      box-shadow 0.35s var(--ease-soft),
      background-color 0.35s ease;
  }
  .site-header.is-scrolled {
    background-color: rgb(255 255 255 / min(1, calc(var(--header-bg) + 0.15)));
    box-shadow: 0 12px 32px -20px rgb(0 0 0 / 0.35);
  }
</style>
