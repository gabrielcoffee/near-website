---
// Mock screens for "Also in Near": Stories (how long + who sees it), Messages (a reply to a story) and
// Video (a clip that actually plays: slow pan, moving progress bar). Same visual language as the How it works phone:
// each card is an `.rs-card` with data-card; FeatureStack.astro + roadmap.ts stack them.
// People and photos are the Unsplash set in src/assets (licensed for commercial use).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const people = import.meta.glob<{ default: ImageMetadata }>("../assets/people/*.jpg", { eager: true });
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.jpg", { eager: true });
const pic = (f: string) => people[`../assets/people/${f}.jpg`].default;
const photo = (f: string) => photos[`../assets/photos/${f}.jpg`].default;

const lasts = ["1h", "6h", "24h", "48h"];
// Who can see the story: the last friend is left out.
const audience = [
  { p: "p1", on: true },
  { p: "p2", on: true },
  { p: "p11", on: true },
  { p: "p13", on: true },
  { p: "p12", on: false },
];
---

<!-- 1 · Stories: pick how long it lasts and who sees it -->
<div class="rs-card" data-card data-pos="0">
  <div class="rs">
    <div class="status"><span>9:41</span><span class="flex gap-1"><i class="sig"></i><i class="bat"></i></span></div>
    <div class="nav sub">
      <span class="back"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg>Back</span>
      <span class="title center">New story</span>
    </div>
    <div class="body compose">
      <div class="preview">
        <Image src={photo("s2")} alt="" width={320} height={200} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" />
      </div>
      <span class="label">Lasts</span>
      <div class="chips">
        {lasts.map((t) => <span class:list={["chip", t === "24h" && "on"]}>{t}</span>)}
      </div>
      <span class="label">Who can see it</span>
      <div class="faces">
        {audience.map((a) => (
          <div class:list={["face", a.on ? "in" : "off"]}>
            <Image src={pic(a.p)} alt="" width={72} height={72} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" />
            {a.on && <i>✓</i>}
          </div>
        ))}
      </div>
      <span class="hint">4 of 5 friends</span>
    </div>
    <div class="answer one"><span class="btn-in">Share</span></div>
  </div>
</div>

<!-- 2 · Messages: Sofia answers your story and the chat starts -->
<div class="rs-card" data-card data-pos="1">
  <div class="rs">
    <div class="status"><span>9:41</span><span class="flex gap-1"><i class="sig"></i><i class="bat"></i></span></div>
    <div class="nav sub">
      <span class="back"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg>Messages</span>
      <div class="peer">
        <div class="ava"><Image src={pic("p1")} alt="" width={80} height={80} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
        <b>Sofia</b>
      </div>
    </div>
    <div class="body chat">
      <div class="quote">
        <div class="thumb"><Image src={photo("s2")} alt="" width={72} height={120} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" /></div>
        <span>Replied to your story</span>
      </div>
      <p class="bubble them">wait, where is this?? 😍</p>
      <p class="bubble me">Ericeira. Go next week?</p>
      <p class="bubble them">yes!!</p>
    </div>
    <div class="composer">
      <span class="field">Message</span>
      <span class="send"><svg viewBox="0 0 24 24"><path d="M12 19V6M6 12l6-6 6 6"/></svg></span>
    </div>
  </div>
</div>

<!-- 3 · Quality: a video that plays, and says what it is -->
<div class="rs-card" data-card data-pos="2">
  <div class="rs">
    <div class="status"><span>9:41</span><span class="flex gap-1"><i class="sig"></i><i class="bat"></i></span></div>
    <div class="nav"><span class="title">Feed</span></div>
    <div class="body feed">
      <article class="post">
        <div class="post-head">
          <div class="ava"><Image src={pic("p2")} alt="" width={80} height={80} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
          <div class="who"><b>Kai</b><span>Ericeira · 1 h ago</span></div>
        </div>
        <div class="video">
          <Image src={photo("s4")} alt="" width={320} height={320} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" />
          <span class="q">1080p</span>
          <span class="sound"><svg viewBox="0 0 24 24"><path d="M4 10v4h3l4 4V6L7 10H4zM15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg></span>
          <span class="progress"><i></i></span>
        </div>
        <p>first wave of the season. cold.</p>
        <span class="meta">2 comments</span>
      </article>
      <article class="post dim">
        <div class="post-head">
          <div class="ava"><Image src={pic("p11")} alt="" width={80} height={80} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
          <div class="who"><b>Maya</b><span>3 h ago</span></div>
        </div>
        <div class="photo short">
          <Image src={photo("s5")} alt="" width={320} height={180} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" />
        </div>
      </article>
    </div>
  </div>
</div>

<style>
  .rs { position: absolute; inset: 0; font-family: var(--font-sans); color: #1a1a1a; background: #fff; --ios-blue: #007aff; --surface: #f4f4f5; --muted: #6b6b70; }
  .status { display: flex; justify-content: space-between; padding: 14px 22px 0; font-size: 11px; font-weight: 600; }
  .status .sig, .status .bat { display: inline-block; height: 8px; border-radius: 2px; background: #1a1a1a; }
  .status .sig { width: 12px; }
  .status .bat { width: 18px; opacity: 0.9; }
  .nav { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 14px 12px 4px; }
  .nav .title { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
  .nav.sub { justify-content: center; }
  .nav .back { position: absolute; left: 10px; display: inline-flex; align-items: center; gap: 1px; font-size: 11px; color: var(--ios-blue); }
  .nav .back svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .nav .title.center { font-size: 12px; }

  .body { position: absolute; inset: 66px 0 0; padding: 6px 12px; overflow: hidden; }
  .ava { width: 23px; height: 23px; border-radius: 999px; overflow: hidden; flex: none; }
  .ava img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .who { display: flex; flex-direction: column; min-width: 0; }
  .who b { font-size: 10.5px; font-weight: 600; line-height: 1.15; }
  .who span { font-size: 8px; color: var(--muted); }
  .label { display: block; margin-top: 14px; font-size: 8px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }

  /* stories */
  .preview { width: 100%; aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; background: var(--surface); }
  .preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .chips { display: flex; gap: 6px; margin-top: 6px; }
  .chip { flex: 1; text-align: center; padding: 8px 0; border-radius: 999px; background: var(--surface); font-size: 12px; font-weight: 600; }
  .chip.on { background: #1a1a1a; color: #fff; }
  .faces { display: flex; gap: 8px; margin-top: 8px; }
  .face { position: relative; width: 36px; height: 36px; border-radius: 999px; }
  .face img { width: 100%; height: 100%; object-fit: cover; border-radius: 999px; display: block; }
  .face.off img { opacity: 0.35; filter: grayscale(1); }
  .face i { position: absolute; right: -3px; bottom: -3px; width: 14px; height: 14px; border-radius: 999px; display: grid; place-items: center; font-style: normal; font-size: 8px; font-weight: 700; color: #fff; background: var(--color-accent); border: 1.5px solid #fff; }
  .hint { display: block; margin-top: 7px; font-size: 10px; color: var(--muted); }
  .answer { position: absolute; left: 0; right: 0; bottom: 0; display: flex; gap: 6px; padding: 8px 12px 16px; background: linear-gradient(transparent, #fff 30%); }
  .answer span { flex: 1; text-align: center; padding: 10px 0; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .btn-in { background: #1a1a1a; color: #fff; }

  /* messages */
  .peer { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .peer b { font-size: 9.5px; font-weight: 600; }
  .body.chat { inset: 80px 0 52px; display: flex; flex-direction: column; justify-content: flex-end; gap: 5px; padding: 6px 10px; }
  .quote { align-self: flex-start; display: flex; align-items: flex-end; gap: 6px; margin-bottom: 2px; }
  .quote .thumb { width: 38px; height: 62px; border-radius: 9px; overflow: hidden; background: var(--surface); flex: none; }
  .quote .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .quote span { font-size: 8.5px; color: var(--muted); padding-bottom: 2px; }
  .bubble { max-width: 76%; padding: 7px 10px; border-radius: 14px; font-size: 11.5px; line-height: 1.25; }
  .bubble.them { align-self: flex-start; background: var(--surface); border-bottom-left-radius: 4px; }
  .bubble.me { align-self: flex-end; background: #1a1a1a; color: #fff; border-bottom-right-radius: 4px; }
  .composer { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 6px; padding: 8px 10px 16px; background: #fff; }
  .composer .field { flex: 1; padding: 7px 10px; border-radius: 999px; border: 1px solid #e3e3e6; font-size: 10px; color: var(--muted); }
  .composer .send { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; background: var(--color-accent); }
  .composer .send svg { width: 12px; height: 12px; fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  /* video */
  .body.feed { padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .post { display: flex; flex-direction: column; }
  .post.dim { opacity: 0.55; }
  .post-head { display: flex; align-items: center; gap: 6px; padding: 6px 10px 5px; }
  .video, .photo { position: relative; width: 100%; background: var(--surface); overflow: hidden; }
  .video { aspect-ratio: 1; }
  .photo.short { aspect-ratio: 16 / 9; }
  .video > img, .photo > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .q { position: absolute; left: 8px; top: 8px; padding: 2px 7px; border-radius: 999px; background: rgb(0 0 0 / 0.55); font-size: 8px; font-weight: 600; color: #fff; }
  .sound { position: absolute; right: 8px; bottom: 12px; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 999px; background: rgb(0 0 0 / 0.55); }
  .sound svg { width: 11px; height: 11px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: rgb(255 255 255 / 0.35); }
  .progress i { display: block; width: 100%; height: 100%; background: #fff; transform-origin: left; transform: scaleX(0.4); }
  .post p { padding: 5px 10px 0; font-size: 10.5px; line-height: 1.25; }
  .post .meta { padding: 2px 10px 6px; font-size: 8px; color: var(--muted); }

  /* The clip plays only on the screen in front: a slow push-in and a progress bar that fills. */
  @keyframes push { from { transform: scale(1) translate(0, 0); } to { transform: scale(1.14) translate(-3%, -2%); } }
  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .rs-card[data-pos="0"] .video > img { animation: push 7s ease-in-out infinite alternate; }
  .rs-card[data-pos="0"] .progress i { animation: fill 7s linear infinite; }
  @media (prefers-reduced-motion: reduce) {
    .rs-card[data-pos="0"] .video > img, .rs-card[data-pos="0"] .progress i { animation: none; }
  }
</style>
