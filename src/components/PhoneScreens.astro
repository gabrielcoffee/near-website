---
// Fake app screens, redrawn 2026-09-07 from the real iOS app (UIKit, iOS 26 glass bars).
// Reference: Home = 3-col rounded-square photo grid, Nearby row above it; Feed = edge-to-edge
// photo post with "1/5" counter + square page dots; Post = post + comments + composer.
// People and post photos are Unsplash portraits/landscapes (Unsplash license: free for commercial use).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const people = import.meta.glob<{ default: ImageMetadata }>("../assets/people/*.jpg", { eager: true });
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.jpg", { eager: true });
const pic = (file: string) => {
  const mod = people[`../assets/people/${file}.jpg`];
  if (!mod) throw new Error(`Unknown person "${file}"`);
  return mod.default;
};
const photo = (file: string) => {
  const mod = photos[`../assets/photos/${file}.jpg`];
  if (!mod) throw new Error(`Unknown photo "${file}"`);
  return mod.default;
};

type Person = { n: string; p: string };
const me: Person = { n: "Gabriel", p: "p3" };
const friends: Person[] = [
  { n: "Sofia", p: "p1" },
  { n: "Kai", p: "p2" },
  { n: "Maya", p: "p11" },
  { n: "Noah", p: "p12" },
  { n: "Lucas", p: "p8" },
  { n: "Leo", p: "p15" },
  { n: "Inês", p: "p13" },
  { n: "Amara", p: "p14" },
];
const nearby: Person[] = [
  { n: "Ana", p: "p4" },
  { n: "Tom", p: "p5" },
];
const grid = [me, ...friends];
---

<!-- 0 · Meet in person: Nearby tiles above the grid, Ana has tapped you (accent frame, pulse) -->
<div class="screen" data-screen="0">
  <div class="status"><span>9:41</span><span class="flex gap-1"><i class="sig"></i><i class="bat"></i></span></div>
  <div class="nav">
    <span class="title">Home</span>
    <span class="pill">
      <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 3.5V17H6.5A2.5 2.5 0 0 1 4 14.5z"/></svg>
      <svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20a2 2 0 0 0 4 0"/></svg>
      <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
    </span>
  </div>
  <div class="home">
    <div class="nearby">
      {nearby.map((p, i) => (
        <div class:list={["cell", i === 0 ? "incoming" : "idle"]}>
          <div class="tile">
            <Image src={pic(p.p)} alt="" width={128} height={128} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" />
          </div>
          <span class="name" style={i === 0 ? "color:var(--color-accent)" : ""}>{i === 0 ? `${p.n} · tapped` : p.n}</span>
        </div>
      ))}
    </div>
    <div class="grid3">
      {grid.slice(0, 6).map((p) => (
        <div class="cell">
          <div class="tile">
            <Image src={pic(p.p)} alt="" width={128} height={128} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" />
          </div>
          <span class="name">{p.n}</span>
        </div>
      ))}
    </div>
  </div>
  <div class="tabbar">
    <span class="tab on"><svg viewBox="0 0 24 24"><path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1z"/></svg>Home</span>
    <span class="tab"><svg viewBox="0 0 24 24"><path d="M9 7h11M9 12h11M9 17h11"/><circle cx="4.5" cy="7" r="1" fill="currentColor"/><circle cx="4.5" cy="12" r="1" fill="currentColor"/><circle cx="4.5" cy="17" r="1" fill="currentColor"/></svg>Feed</span>
    <span class="tab"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M6.5 18.5c1.2-2.3 3.1-3.5 5.5-3.5s4.3 1.2 5.5 3.5"/></svg>Profile</span>
  </div>
</div>

<!-- 1 · Your grid: 3×3, one tile mid-drag -->
<div class="screen" data-screen="1">
  <div class="status"><span>9:41</span><span class="flex gap-1"><i class="sig"></i><i class="bat"></i></span></div>
  <div class="nav">
    <span class="title">Home</span>
    <span class="pill">
      <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 3.5V17H6.5A2.5 2.5 0 0 1 4 14.5z"/></svg>
      <svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20a2 2 0 0 0 4 0"/></svg>
      <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
    </span>
  </div>
  <div class="home">
    <div class="grid3">
      {grid.map((p, i) => (
        <div class:list={["cell", i === 4 && "dragging"]}>
          <div class="tile">
            <Image src={pic(p.p)} alt="" width={128} height={128} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" />
          </div>
          <span class="name">{p.n}</span>
        </div>
      ))}
    </div>
  </div>
  <div class="tabbar">
    <span class="tab on"><svg viewBox="0 0 24 24"><path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1z"/></svg>Home</span>
    <span class="tab"><svg viewBox="0 0 24 24"><path d="M9 7h11M9 12h11M9 17h11"/><circle cx="4.5" cy="7" r="1" fill="currentColor"/><circle cx="4.5" cy="12" r="1" fill="currentColor"/><circle cx="4.5" cy="17" r="1" fill="currentColor"/></svg>Feed</span>
    <span class="tab"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M6.5 18.5c1.2-2.3 3.1-3.5 5.5-3.5s4.3 1.2 5.5 3.5"/></svg>Profile</span>
  </div>
</div>

<!-- 2 · Feed: edge-to-edge photo, counter, square page dots, caption, comment count -->
<div class="screen" data-screen="2">
  <div class="status"><span>9:41</span><span class="flex gap-1"><i class="sig"></i><i class="bat"></i></span></div>
  <div class="nav">
    <span class="title">Feed</span>
    <span class="pill">
      <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 3.5V17H6.5A2.5 2.5 0 0 1 4 14.5z"/></svg>
      <svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20a2 2 0 0 0 4 0"/></svg>
      <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
    </span>
  </div>
  <div class="feed">
    <article class="post">
      <div class="post-head">
        <div class="ava"><Image src={pic("p11")} alt="" width={80} height={80} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
        <div class="who"><b>Maya</b><span>23 h ago</span></div>
        <span class="loc">📍 Big Sur</span>
      </div>
      <div class="photo">
        <Image src={photo("s5")} alt="" width={320} height={320} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" />
        <span class="counter">1/5</span>
        <span class="dots"><i class="on"></i><i></i><i></i><i></i><i></i></span>
      </div>
      <p>road trip dump 🚙</p>
      <span class="meta">3 comments</span>
    </article>
    <article class="post">
      <div class="post-head">
        <div class="ava"><Image src={pic("p1")} alt="" width={80} height={80} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
        <div class="who"><b>Sofia</b><span>1 day ago</span></div>
        <span class="loc">📍 Sintra</span>
      </div>
      <div class="photo pair">
        <Image src={photo("s2")} alt="" width={160} height={160} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" />
        <Image src={photo("s3")} alt="" width={160} height={160} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" />
      </div>
    </article>
  </div>
  <div class="tabbar">
    <span class="tab"><svg viewBox="0 0 24 24"><path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1z"/></svg>Home</span>
    <span class="tab on"><svg viewBox="0 0 24 24"><path d="M9 7h11M9 12h11M9 17h11"/><circle cx="4.5" cy="7" r="1" fill="currentColor"/><circle cx="4.5" cy="12" r="1" fill="currentColor"/><circle cx="4.5" cy="17" r="1" fill="currentColor"/></svg>Feed</span>
    <span class="tab"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M6.5 18.5c1.2-2.3 3.1-3.5 5.5-3.5s4.3 1.2 5.5 3.5"/></svg>Profile</span>
  </div>
</div>

<!-- 3 · Post: same card, comments below, composer at the bottom -->
<div class="screen" data-screen="3">
  <div class="status"><span>9:41</span><span class="flex gap-1"><i class="sig"></i><i class="bat"></i></span></div>
  <div class="nav sub">
    <span class="back"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg>Feed</span>
    <span class="title center">Post</span>
  </div>
  <div class="feed">
    <article class="post">
      <div class="post-head">
        <div class="ava"><Image src={pic("p11")} alt="" width={80} height={80} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
        <div class="who"><b>Maya</b><span>23 h ago</span></div>
        <span class="loc">📍 Big Sur</span>
      </div>
      <div class="photo short">
        <Image src={photo("s5")} alt="" width={320} height={180} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" />
      </div>
      <p>road trip dump 🚙</p>
      <span class="meta">3 comments</span>
    </article>
    <div class="comments">
      <div class="comment">
        <div class="ava xs"><Image src={pic("p2")} alt="" width={64} height={64} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
        <div><b>Kai</b><p>which one is the pier photo</p></div>
      </div>
      <div class="comment">
        <div class="ava xs"><Image src={pic("p12")} alt="" width={64} height={64} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
        <div><b>Noah</b><p>next time you're driving us all</p></div>
      </div>
      <div class="comment">
        <div class="ava xs"><Image src={pic("p11")} alt="" width={64} height={64} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></div>
        <div><b>Maya</b><p>deal. sunday?</p></div>
      </div>
    </div>
  </div>
  <div class="composer"><span class="field">Add a comment</span><span class="send">Post</span></div>
</div>

<style>
  .screen { font-family: var(--font-sans); color: #1a1a1a; background: #fff; --ios-blue: #007aff; --surface: #f4f4f5; --muted: #6b6b70; }
  .status { display: flex; justify-content: space-between; padding: 14px 22px 0; font-size: 11px; font-weight: 600; }
  .status .sig, .status .bat { display: inline-block; height: 8px; border-radius: 2px; background: #1a1a1a; }
  .status .sig { width: 12px; }
  .status .bat { width: 18px; opacity: 0.9; }

  /* nav: inline title left, floating actions pill right */
  .nav { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 14px 10px 4px 12px; }
  .nav .title { font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
  .nav .pill { display: flex; align-items: center; gap: 10px; height: 26px; padding: 0 10px; border-radius: 999px; background: #fff; box-shadow: 0 1px 1px rgb(0 0 0 / 0.04), 0 4px 14px -2px rgb(0 0 0 / 0.12); }
  .nav .pill svg { width: 13px; height: 13px; fill: none; stroke: #1a1a1a; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .nav.sub { justify-content: center; }
  .nav .back { position: absolute; left: 10px; display: inline-flex; align-items: center; gap: 1px; font-size: 11px; color: var(--ios-blue); }
  .nav .back svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .nav .title.center { font-size: 12px; }

  /* home: nearby row + 3-column grid, vertically centred like the app */
  .home { position: absolute; inset: 60px 0 58px; display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 0 9px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 9px; row-gap: 5px; }
  .cell { display: flex; flex-direction: column; align-items: center; gap: 3px; position: relative; }
  .tile { width: 100%; aspect-ratio: 1; border-radius: 8px; overflow: hidden; background: var(--surface); }
  .tile img, .ava img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .name { font-size: 8.5px; font-weight: 500; line-height: 1.1; text-align: center; color: #1a1a1a; }
  .cell.dragging { z-index: 2; }
  .cell.dragging .tile { transform: rotate(-3deg) scale(1.1); box-shadow: 0 12px 22px -8px rgb(0 0 0 / 0.4); animation: wiggle 0.8s ease-in-out infinite; }
  .cell.dragging .name { opacity: 0; }
  @keyframes wiggle { 0%,100% { transform: rotate(-3deg) scale(1.1); } 50% { transform: rotate(-0.5deg) scale(1.1); } }

  .nearby { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 9px; row-gap: 5px; padding-bottom: 4px; }
  .cell.incoming .tile { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .phone[data-active="0"] .cell.incoming .tile { animation: tapped 1.6s ease-in-out infinite; }
  @keyframes tapped { 0%, 100% { outline-offset: 2px; } 50% { outline-offset: 4px; } }

  /* floating glass tab bar */
  .tabbar { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); display: flex; align-items: center; padding: 3px; border-radius: 999px; background: rgb(255 255 255 / 0.82); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 1px 1px rgb(0 0 0 / 0.04), 0 6px 18px -4px rgb(0 0 0 / 0.16); }
  .tab { display: flex; flex-direction: column; align-items: center; gap: 1px; width: 52px; padding: 5px 0 4px; border-radius: 999px; font-size: 7px; font-weight: 500; color: #1a1a1a; }
  .tab svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .tab.on { color: var(--ios-blue); background: rgb(0 0 0 / 0.06); }

  /* feed */
  .feed { position: absolute; inset: 80px 0 0; overflow: hidden; display: flex; flex-direction: column; gap: 6px; }
  .post { display: flex; flex-direction: column; }
  .post-head { display: flex; align-items: flex-start; gap: 5px; padding: 6px 9px 5px; }
  .ava { width: 23px; height: 23px; border-radius: 999px; display: grid; place-items: center; flex: none; overflow: hidden; }
  .ava.xs { width: 17px; height: 17px; }
  .who { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .who b { font-size: 10.5px; font-weight: 600; line-height: 1.15; }
  .who span { font-size: 8px; color: var(--muted); }
  .loc { font-size: 8px; font-weight: 500; color: var(--muted); padding-top: 1px; }
  .photo { position: relative; width: 100%; aspect-ratio: 1; background: var(--surface); overflow: hidden; }
  .photo > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .photo.short { aspect-ratio: 16 / 9; }
  .photo.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #fff; }
  .counter { position: absolute; top: 8px; right: 8px; padding: 2px 6px; border-radius: 999px; background: rgb(0 0 0 / 0.55); color: #fff; font-size: 8px; font-weight: 600; }
  .dots { position: absolute; left: 50%; bottom: 6px; transform: translateX(-50%); display: flex; gap: 2px; }
  .dots i { width: 4px; height: 4px; border-radius: 1px; background: rgb(255 255 255 / 0.45); }
  .dots i.on { background: #fff; }
  .post p { padding: 5px 9px 0; font-size: 10.5px; line-height: 1.25; }
  .post .meta { padding: 2px 9px 6px; font-size: 8px; color: var(--muted); }

  /* comments + composer */
  .comments { display: flex; flex-direction: column; gap: 6px; padding: 2px 9px; }
  .comment { display: flex; align-items: flex-start; gap: 5px; }
  .comment b { display: block; font-size: 8.5px; font-weight: 600; line-height: 1.2; }
  .comment p { font-size: 9.5px; line-height: 1.25; padding: 0; }
  .composer { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 6px; padding: 6px 9px 18px; background: var(--surface); }
  .composer .field { flex: 1; padding: 6px 8px; border-radius: 5px; background: #fff; border: 1px solid #d9d9dc; font-size: 9.5px; color: #9a9aa0; }
  .composer .send { font-size: 10px; font-weight: 600; color: #a5a5aa; }

  @media (prefers-reduced-motion: reduce) { .cell.dragging .tile, .cell.incoming .tile { animation: none !important; } }
</style>
