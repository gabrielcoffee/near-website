---
// The Near Spark page. Four things that matter (chat, photos and video, archive and highlights, voice comments) in a
// borderless 2x2 grid: a hand-built visual on top, a short title and one line under it. Then the two
// plans, then a compact "and the rest" table. No buy button until the app is live. Prices: config.ts.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { NEAR_SPARK_PRICE, type Locale } from "../config";
import type { Dictionary } from "../i18n/en";

interface Props {
  dict: Dictionary;
  locale: Locale;
}
const { dict, locale } = Astro.props;
const { plus } = dict;
const price = NEAR_SPARK_PRICE[locale];
const name = dict.nav.plus.replace(/\s*\S+$/, "");
const accentName = dict.nav.plus.split(" ").pop();

const people = import.meta.glob<{ default: ImageMetadata }>("../assets/people/*.jpg", { eager: true });
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.jpg", { eager: true });
const pic = (f: string) => people[`../assets/people/${f}.jpg`].default;
const photo = (f: string) => photos[`../assets/photos/${f}.jpg`].default;

const highlights = [
  { p: "s2", t: "Ericeira" },
  { p: "s6", t: "Sintra" },
  { p: "s1", t: "2025" },
  { p: "s3", t: "Casa" },
];
const archive = ["s4", "s5", "s3"];
// A voice comment as the app draws it: a play disc, the note's bars (played ones dark) and its length.
const wave = [4, 9, 14, 7, 12, 18, 10, 6, 13, 16, 8, 5, 11, 15, 9, 4, 7, 12, 6, 10, 14, 8];
const [chat, media, memory, voice] = plus.features;
---

<section class="container-x relative pb-16 pt-36 md:pb-24 md:pt-44">
  <div class="max-w-2xl" data-reveal-group>
    <h1 class="text-display font-medium tracking-tight" data-reveal>{name} <span class="text-accent">{accentName}</span></h1>
    <p class="lede mt-4" data-reveal>{plus.intro}</p>
  </div>
</section>

<!-- The four features, a 2x2 grid: visual on top, title and one line under it -->
<section class="container-x pb-24 md:pb-36">
  <div class="features">
    <div class="feature">
      <div class="feature-visual" data-reveal>
        <div class="shot chat">
          <div class="peer">
            <span class="ava"><Image src={pic("p1")} alt="" width={96} height={96} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></span>
            <b>Sofia</b>
          </div>
          <div class="quote">
            <span class="thumb"><Image src={photo("s2")} alt="" width={96} height={160} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" /></span>
            <span>{plus.labels.reply}</span>
          </div>
          <p class="bubble them">wait, where is this?? 😍</p>
          <p class="bubble me">Ericeira. Go next week?</p>
          <p class="bubble them">yes!!</p>
          <div class="composer"><span></span><i></i></div>
        </div>
      </div>
      <div class="feature-text" data-reveal-group>
        <h2 class="feature-title" data-reveal>{chat.title}</h2>
        <p class="feature-body" data-reveal>{chat.body}</p>
      </div>
    </div>

    <!-- The Instagram frame fits inside the Near Spark one, to scale (1080 vs 4032) -->
    <div class="feature">
      <div class="feature-visual" data-reveal>
        <figure class="compare-photo">
          <Image src={photo("s6")} alt="" width={640} height={800} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" />
          <figcaption class="tag near">{plus.labels.near}</figcaption>
          <div class="insta">
            <Image src={photo("s6")} alt="" width={240} height={300} format="webp" quality={60} loading="lazy" decoding="async" draggable="false" />
            <span class="tag">{plus.labels.instagram}</span>
          </div>
        </figure>
        <p class="video-line">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2.5" /><path d="m16 10.5 5-3v9l-5-3z" /></svg>
          {plus.labels.video}
        </p>
      </div>
      <div class="feature-text" data-reveal-group>
        <h2 class="feature-title" data-reveal>{media.title}</h2>
        <p class="feature-body" data-reveal>{media.body}</p>
      </div>
    </div>

    <div class="feature">
      <div class="feature-visual" data-reveal>
        <div class="shot profile">
          <div class="head">
            <span class="ava big"><Image src={pic("p3")} alt="" width={120} height={120} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></span>
            <div><b>Gabriel</b><span>12 friends</span></div>
          </div>
          <span class="label">{plus.labels.highlights}</span>
          <div class="rings">
            {highlights.map((h) => (
              <div class="ring">
                <span><Image src={photo(h.p)} alt="" width={120} height={120} format="webp" quality={72} loading="lazy" decoding="async" draggable="false" /></span>
                <small>{h.t}</small>
              </div>
            ))}
          </div>
          <span class="label">{plus.labels.archive}</span>
          <div class="grid3">
            {archive.map((a) => (
              <span class="cell"><Image src={photo(a)} alt="" width={160} height={200} format="webp" quality={68} loading="lazy" decoding="async" draggable="false" /></span>
            ))}
          </div>
        </div>
      </div>
      <div class="feature-text" data-reveal-group>
        <h2 class="feature-title" data-reveal>{memory.title}</h2>
        <p class="feature-body" data-reveal>{memory.body}</p>
      </div>
    </div>

    <div class="feature">
      <div class="feature-visual" data-reveal>
        <div class="shot voice">
          <b class="sheet-title">3 comments</b>
          <div class="row">
            <span class="ava"><Image src={pic("p2")} alt="" width={96} height={96} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></span>
            <div><b>Kai</b><p>That light is unreal, where is this?</p></div>
          </div>
          <div class="row">
            <span class="ava"><Image src={pic("p1")} alt="" width={96} height={96} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></span>
            <div>
              <b>Sofia</b>
              <span class="clip" role="img" aria-label={plus.labels.voice}>
                <i class="play"></i>
                <span class="wave">{wave.map((h, n) => <i class:list={[n < 9 && "on"]} style={`--h:${h}px`}></i>)}</span>
                <small>0:08</small>
              </span>
            </div>
          </div>
          <div class="row">
            <span class="ava"><Image src={pic("p3")} alt="" width={96} height={96} format="webp" quality={80} loading="lazy" decoding="async" draggable="false" /></span>
            <div>
              <b>{plus.labels.you}</b>
              <span class="clip">
                <i class="play"></i>
                <span class="wave">{wave.slice().reverse().map((h) => <i style={`--h:${h}px`}></i>)}</span>
                <small>0:14</small>
              </span>
            </div>
          </div>
          <div class="composer">
            <span></span>
            <i class="mic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg></i>
          </div>
        </div>
      </div>
      <div class="feature-text" data-reveal-group>
        <h2 class="feature-title" data-reveal>{voice.title}</h2>
        <p class="feature-body" data-reveal>{voice.body}</p>
      </div>
    </div>
  </div>
</section>

<!-- Plans -->
<section id="plans" class="container-x pb-24 md:pb-36">
  <h2 class="h-section" data-reveal>{plus.plans.title}</h2>
  <div class="plans mt-10 md:mt-14" data-reveal>
    <div class="plan">
      <span class="plan-name">{plus.plans.monthly}</span>
      <p class="plan-price"><b>{price.monthly}</b><span>{plus.plans.perMonth}</span></p>
    </div>
    <div class="plan best">
      <span class="plan-name">{plus.plans.yearly}<em>{plus.plans.save.replace("{pct}", price.saving)}</em></span>
      <p class="plan-price"><b>{price.yearly}</b><span>{plus.plans.perYear}</span></p>
      <p class="plan-eq">{plus.plans.equals.replace("{price}", price.yearlyPerMonth)}</p>
    </div>
  </div>
  <p class="mt-6 text-body font-medium text-accent" data-reveal>{plus.plans.trial}</p>
  <p class="mt-1 text-small text-muted" data-reveal>{plus.plans.soon}</p>
</section>

<!-- And the rest -->
<section class="container-x pb-24 md:pb-36">
  <h2 class="h-section" data-reveal>{plus.more.title}</h2>
  <table class="compare mt-10 w-full max-w-2xl md:mt-14" data-reveal>
    <thead>
      <tr>
        <td></td>
        <th scope="col">{plus.free}</th>
        <th scope="col" class="is-plus">{name} <span class="text-accent">{accentName}</span></th>
      </tr>
    </thead>
    <tbody>
      {plus.more.rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          {[row.free, row.plus].map((v, i) => (
            <td class:list={[i === 1 && "is-plus"]}>
              {v === true ? (
                <svg class="check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /><title>✓</title></svg>
              ) : v === false ? (
                <span class="dash">–</span>
              ) : (
                v
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  /* ---- Features: 2x2 grid, no boxes. Each visual sits in a stage of one height so the titles line up ---- */
  .features { display: grid; gap: 4.5rem; }
  @media (min-width: 768px) {
    .features { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; row-gap: 6rem; }
  }
  @media (min-width: 1024px) {
    .features { column-gap: 4rem; }
  }
  .feature { display: flex; flex-direction: column; }
  .feature-text { margin-top: 2rem; max-width: 26rem; }
  .feature-title {
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .feature-body {
    margin-top: 0.6rem;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .feature-visual { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  @media (min-width: 768px) {
    .feature-visual { min-height: 440px; }
  }
  .feature-visual img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* ---- A phone-less app card: white, soft shadow, the app's type ---- */
  .shot {
    width: 100%;
    max-width: 320px;
    padding: 18px 18px 16px;
    border-radius: 28px;
    background: #fff;
    border: 1px solid var(--color-line);
    box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.35);
    color: #1c1c1e;
    --surface: #f4f4f5;
    --muted: #8e8e93;
  }
  .ava { display: inline-block; width: 28px; height: 28px; border-radius: 999px; overflow: hidden; flex: none; }
  .ava.big { width: 56px; height: 56px; }
  .label { display: block; margin-top: 18px; font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }

  /* chat */
  .chat { display: flex; flex-direction: column; gap: 8px; }
  .chat .peer { display: flex; flex-direction: column; align-items: center; gap: 4px; margin-bottom: 6px; font-size: 13px; }
  .chat .quote { align-self: flex-start; display: flex; align-items: flex-end; gap: 8px; margin-top: 4px; }
  .chat .thumb { display: block; width: 46px; height: 76px; border-radius: 10px; overflow: hidden; }
  .chat .quote > span:last-child { font-size: 12px; color: var(--muted); padding-bottom: 4px; }
  .bubble { max-width: 78%; padding: 10px 14px; border-radius: 18px; font-size: 15px; line-height: 1.3; }
  .bubble.them { align-self: flex-start; background: var(--surface); border-bottom-left-radius: 6px; }
  .bubble.me { align-self: flex-end; background: #1c1c1e; color: #fff; border-bottom-right-radius: 6px; }
  .chat .composer { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
  .chat .composer span { flex: 1; height: 36px; border-radius: 999px; border: 1px solid #e3e3e6; }
  .chat .composer i { width: 32px; height: 32px; border-radius: 999px; background: var(--color-accent); }

  /* photo compare: Instagram's 1080 px frame sits inside the 4032 px one, at scale */
  .compare-photo {
    position: relative;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.45);
  }
  .compare-photo .insta {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: 27%;
    aspect-ratio: 4 / 5;
    border-radius: 10px;
    overflow: hidden;
    outline: 2px solid #fff;
    box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.5);
  }
  .compare-photo .insta img { filter: blur(0.6px) saturate(0.92); }
  .tag {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    backdrop-filter: blur(6px);
  }
  .tag.near { left: auto; right: 14px; bottom: 14px; transform: none; font-size: 13px; padding: 6px 12px; }
  .video-line {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-ink);
  }
  .video-line svg { color: var(--color-accent); }

  /* profile: highlights row + archive grid */
  .profile .head { display: flex; align-items: center; gap: 12px; }
  .profile .head b { display: block; font-size: 17px; font-weight: 600; }
  .profile .head span:not(.ava) { font-size: 13px; color: var(--muted); }
  .rings { display: flex; gap: 14px; margin-top: 10px; }
  .ring { display: flex; flex-direction: column; align-items: center; gap: 5px; }
  .ring > span { display: block; width: 56px; height: 56px; border-radius: 999px; overflow: hidden; outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .ring small { font-size: 11px; color: #1c1c1e; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin-top: 10px; }
  .cell { display: block; aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; }

  /* voice comments: rows like the comments sheet, each clip a pill with a play disc and bars */
  .voice { display: flex; flex-direction: column; gap: 14px; }
  .voice .sheet-title { align-self: center; font-size: 13px; font-weight: 600; }
  .voice .row { display: flex; align-items: flex-start; gap: 10px; }
  .voice .row b { display: block; font-size: 12px; font-weight: 600; }
  .voice .row p { font-size: 14px; line-height: 1.3; }
  .clip { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; padding: 5px 12px 5px 5px; border-radius: 20px; background: var(--surface); }
  .clip .play { position: relative; width: 26px; height: 26px; border-radius: 999px; background: #1c1c1e; flex: none; }
  .clip .play::after { content: ""; position: absolute; left: 10px; top: 8px; border-left: 8px solid #fff; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .wave { display: flex; align-items: center; gap: 2px; height: 20px; }
  .wave i { width: 2px; height: var(--h); border-radius: 1px; background: rgb(28 28 30 / 0.45); }
  .wave i.on { background: #1c1c1e; }
  .clip small { font-size: 11px; font-variant-numeric: tabular-nums; color: var(--muted); }
  .voice .composer { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
  .voice .composer span { flex: 1; height: 36px; border-radius: 999px; background: var(--surface); }
  .voice .composer .mic { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; background: var(--surface); }
  .voice .composer .mic svg { width: 17px; height: 17px; fill: none; stroke: #1c1c1e; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  /* ---- Plans ---- */
  .plans { display: grid; gap: 1rem; max-width: 42rem; }
  @media (min-width: 640px) { .plans { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
  .plan {
    padding: 1.5rem 1.6rem 1.6rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .plan.best {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 22%, var(--color-line));
  }
  .plan-name { display: flex; align-items: center; gap: 0.6rem; font-size: var(--text-small); font-weight: 500; color: var(--color-ink); }
  .plan-name em {
    font-style: normal;
    font-size: var(--text-small);
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
  }
  .plan-price { margin-top: 0.9rem; display: flex; align-items: baseline; gap: 0.35rem; }
  .plan-price b { font-size: var(--text-display); font-weight: 500; letter-spacing: -0.03em; line-height: 1; }
  .plan-price span { font-size: var(--text-small); color: var(--color-muted); }
  .plan-eq { margin-top: 0.5rem; font-size: var(--text-small); color: var(--color-muted); }

  /* ---- And the rest: compact table ---- */
  .compare { border-collapse: separate; border-spacing: 0; table-layout: fixed; font-size: var(--text-body); text-align: left; }
  .compare th:first-child, .compare td:first-child { width: 44%; }
  .compare th, .compare td { padding: 0.85rem 0.75rem; border-top: 1px solid var(--color-line); vertical-align: middle; font-weight: 400; color: var(--color-ink); }
  .compare thead th, .compare thead td { border-top: 0; font-weight: 500; padding-top: 0.5rem; }
  .compare tbody th { padding-left: 0; }
  .compare .is-plus { background: var(--color-accent-soft); padding-left: 1.1rem; border-top-color: color-mix(in srgb, var(--color-accent) 14%, var(--color-line)); }
  .compare thead .is-plus { border-radius: 16px 16px 0 0; }
  .compare tbody tr:last-child .is-plus { border-radius: 0 0 16px 16px; }
  .check { display: block; color: var(--color-ink); }
  .is-plus .check { color: var(--color-accent); }
  .dash { color: var(--color-muted); }
  @media (min-width: 768px) {
    .compare th, .compare td { padding: 1rem 1rem; }
    .compare tbody th { padding-left: 0; }
  }
</style>
